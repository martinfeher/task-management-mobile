EXPO_PUBLIC_API_URL=http://localhost:3000

# development: skip login UI; auto sign-in as default user (__DEV__ only)
APPLICATION_ENV=development

# Default dev user (optional; fallback in dev-default-user.ts)
EXPO_PUBLIC_DEV_DEFAULT_USER_EMAIL=mn.feher@gmail.com
# test@test.io: no password in DB (Google OAuth only) — cannot retrieve from database.
# For auto sign-in use a credential user, e.g. mobiletest1794071382@example.com, or set
# LOCAL_DEV_SIGN_IN_PASSWORD in src/lib/dev-auto-sign-in.local.ts (must match server).

# Password: see gitignored src/lib/dev-auto-sign-in.local.ts (preferred)
# Google OAuth in dev: Continue with Google on the setup / sign-in screen (needs API + Google OAuth configured).

# Opt out of auto sign-in: EXPO_PUBLIC_DEV_AUTO_SIGN_IN=false
EXPO_PUBLIC_DEV_AUTO_SIGN_IN=true


