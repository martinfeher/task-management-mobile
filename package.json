{
  "name": "todolist",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client --localhost --port 8081",
    "start:dev": "expo start --dev-client --localhost --port 8081",
    "start:dev:device": "expo start --dev-client --lan --port 8081",
    "start:dev:tunnel": "expo start --dev-client --tunnel --port 8081",
    "connect:ios-sim": "xcrun simctl launch booted com.martinfeher.todolist",
    "connect:ios-sim:deeplink": "xcrun simctl openurl booted \"exp+todolist://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081\"",
    "ios:device": "expo run:ios --device --no-bundler",
    "prebuild": "expo prebuild",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "test": "jest"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.19",
    "@callstack/liquid-glass": "^0.8.1",
    "@expo-google-fonts/great-vibes": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/drawer": "^7.13.6",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.3.14",
    "better-auth": "^1.7.19",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "heroui-native": "^1.0.8",
    "node-html-parser": "^9.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-native": "0.88.1",
    "react-native-dev-inspector": "^1.1.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-drawer-layout": "^4.2.10",
    "react-native-enriched": "^0.8.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  }
}
